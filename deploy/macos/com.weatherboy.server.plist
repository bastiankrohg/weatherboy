<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- weatherboy's web server (printer, phone base on USB): starts at login, and again if it stops.
     caffeinate -is keeps the Mac awake while it runs, also on battery. Logs: ~/weatherboy.log
     Restart: launchctl kickstart -k gui/$(id -u)/com.weatherboy.server -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.weatherboy.server</string>
	<key>WorkingDirectory</key>
	<string>/Users/Bastian/torggata/weatherboy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-is</string>
		<string>/Users/Bastian/.local/bin/uv</string>
		<string>run</string>
		<string>web.py</string>
		<string>--printer</string>
		<string>192.168.0.108</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/Bastian/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/Bastian/weatherboy.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/Bastian/weatherboy.log</string>
</dict>
</plist>
